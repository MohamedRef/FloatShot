<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_app"
                android:contentDescription="@string/app_name" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/eyebrow"
                android:textAllCaps="true"
                android:letterSpacing="0.13"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/headline"
                android:textColor="@color/ink"
                android:textSize="29sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/subtitle"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/muted"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/dot_disabled" />
                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:text="@string/status_off"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
                <Button
                    android:id="@+id/enable_button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_background"
                    android:backgroundTint="@null"
                    android:text="@string/open_accessibility"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="@color/white" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/how_title"
                android:textSize="18sp"
                android:textColor="@color/ink"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/tap_title" android:textColor="@color/ink"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/tap_detail"
                    android:textSize="13sp" android:textColor="@color/muted" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
                    android:background="@color/outline" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/hold_title" android:textColor="@color/ink"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/hold_detail"
                    android:textSize="13sp" android:textColor="@color/muted" />
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
                    android:background="@color/outline" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/drag_title" android:textColor="@color/ink"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/drag_detail"
                    android:textSize="13sp" android:textColor="@color/muted" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/settings_title"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_background"
                android:padding="20dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/opacity_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opacity_label"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/opacity_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="62"
                    android:progress="10" />
                <TextView
                    android:id="@+id/size_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/size_label"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />
                <SeekBar
                    android:id="@+id/size_seek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="24"
                    android:progress="6" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/privacy_note"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/muted" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/limitations_note"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
